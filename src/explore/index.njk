---
{
 "layout": "layouts/base.njk",
 "pagination": {
  "data": "langs",
  "size": 1,
  "alias": "lang"
 },
 "path": "/explore/",
 "permalink": "{{ \"/explore/\" | lurl(lang) }}index.html",
 "titleKey": "explore_025",
 "navKey": "explore",
 "headerStyle": "position:relative;background:var(--ink);color:var(--cream)"
}
---


{% include "partials/header.njk" %}
<section aria-labelledby="feat-hero-h" class="page-hero" style="position:relative;background:var(--night);color:var(--cream);overflow:hidden">
<img src="/images/ajanta-prayer-hall.jpg" alt="" class="page-hero-img" style="position:absolute;right:0;top:0;height:100%;width:44%;object-fit:cover;opacity:.55">
<div aria-hidden="true" class="page-hero-fade" style="position:absolute;right:0;top:0;height:100%;width:44%;background:linear-gradient(90deg,var(--night) 0%,rgba(18,13,10,0) 45%)"></div>
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;position:relative;padding-top:clamp(40px,4.44vw,64px);padding-bottom:clamp(40px,4.44vw,64px);display:flex;flex-direction:column;gap:24px">
<p style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--gold)">{{ "explore_001" | t(lang) | safe }}</p>
<h1 id="feat-hero-h" style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(46px,5.6vw,82px);line-height:1.02;margin:0;max-width:820px;text-wrap:balance">{{ "explore_002" | t(lang) | safe }}</h1>
<p style="margin:0;font-size:19px;color:var(--stone);max-width:600px">{{ "explore_003" | t(lang) | safe }}</p>
<div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:4px"><a href="{{ "/ajanta" | lurl(lang) }}" style="display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 26px;border-radius:2px;font-size:15px;font-weight:600;text-decoration:none;box-sizing:border-box;background:var(--accent);color:var(--white)">{{ "explore_004" | t(lang) | safe }}</a><a href="{{ "/visit#tickets" | lurl(lang) }}" style="display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 26px;border-radius:2px;font-size:15px;font-weight:600;text-decoration:none;box-sizing:border-box;border:1px solid rgba(247,244,239,.7);color:var(--cream)">{{ "explore_005" | t(lang) | safe }}</a></div>
</div>
</section>

<section aria-labelledby="exp-h" style="padding:clamp(35px,3.89vw,56px) 0 clamp(45px,5.00vw,72px)">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;display:flex;flex-direction:column;gap:34px">
<div style="display:flex;flex-direction:column;gap:12px;max-width:760px">
<p style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--accent)">{{ "explore_006" | t(lang) | safe }}</p>
<h2 id="exp-h" style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(32px,3.2vw,44px);line-height:1.1;margin:0">{{ "explore_007" | t(lang) | safe }}</h2>
<p style="margin:0;font-size:18px;color:var(--muted)">{{ "explore_008" | t(lang) | safe }}</p>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr));gap:40px 28px;align-items:start">
<a href="{{ "/explore/lifelike-scenes" | lurl(lang) }}" class="card" style="display:flex;flex-direction:column;gap:18px">
<div style="overflow:hidden;aspect-ratio:5/4;background:var(--sand)"><img src="/images/scholars-diorama.jpg" alt="{{ "explore_009" | t(lang) | safe }}" style="width:100%;height:100%;object-fit:cover;display:block"></div>
<div style="display:flex;flex-direction:column;gap:8px">
<span style="font-size:13px;font-weight:600;letter-spacing:.18em;color:var(--accent)">{{ "explore_010" | t(lang) | safe }}</span>
<h3 style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:28px;line-height:1.15;margin:0">{{ "explore_011" | t(lang) | safe }}</h3>
<p style="margin:0;color:var(--muted);font-size:16px;text-wrap:pretty">{{ "explore_012" | t(lang) | safe }}</p>
</div>
</a>
<a href="{{ "/explore/legacy-architecture" | lurl(lang) }}" class="card stagger" style="margin-top:44px;display:flex;flex-direction:column;gap:18px">
<div style="overflow:hidden;aspect-ratio:5/4;background:var(--sand)"><img src="/images/sandstone-temple-facade.jpg" alt="{{ "explore_013" | t(lang) | safe }}" style="width:100%;height:100%;object-fit:cover;display:block"></div>
<div style="display:flex;flex-direction:column;gap:8px">
<span style="font-size:13px;font-weight:600;letter-spacing:.18em;color:var(--accent)">{{ "explore_014" | t(lang) | safe }}</span>
<h3 style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:28px;line-height:1.15;margin:0">{{ "explore_015" | t(lang) | safe }}</h3>
<p style="margin:0;color:var(--muted);font-size:16px;text-wrap:pretty">{{ "explore_016" | t(lang) | safe }}</p>
</div>
</a>
<a href="{{ "/explore/walking-into-scripture" | lurl(lang) }}" class="card" style="display:flex;flex-direction:column;gap:18px">
<div style="overflow:hidden;aspect-ratio:5/4;background:var(--sand)"><img src="/images/sage-scripture-panels.jpg" alt="{{ "explore_017" | t(lang) | safe }}" style="width:100%;height:100%;object-fit:cover;display:block"></div>
<div style="display:flex;flex-direction:column;gap:8px">
<span style="font-size:13px;font-weight:600;letter-spacing:.18em;color:var(--accent)">{{ "explore_018" | t(lang) | safe }}</span>
<h3 style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:28px;line-height:1.15;margin:0">{{ "explore_019" | t(lang) | safe }}</h3>
<p style="margin:0;color:var(--muted);font-size:16px;text-wrap:pretty">{{ "explore_020" | t(lang) | safe }}</p>
</div>
</a>
<a href="{{ "/explore/living-tapestry" | lurl(lang) }}" class="card stagger" style="margin-top:44px;display:flex;flex-direction:column;gap:18px">
<div style="overflow:hidden;aspect-ratio:5/4;background:var(--sand)"><img src="/images/festival-street.jpg" alt="{{ "explore_021" | t(lang) | safe }}" style="width:100%;height:100%;object-fit:cover;display:block"></div>
<div style="display:flex;flex-direction:column;gap:8px">
<span style="font-size:13px;font-weight:600;letter-spacing:.18em;color:var(--accent)">{{ "explore_022" | t(lang) | safe }}</span>
<h3 style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:28px;line-height:1.15;margin:0">{{ "explore_023" | t(lang) | safe }}</h3>
<p style="margin:0;color:var(--muted);font-size:16px;text-wrap:pretty">{{ "explore_024" | t(lang) | safe }}</p>
</div>
</a>
</div>
</div>
</section>

