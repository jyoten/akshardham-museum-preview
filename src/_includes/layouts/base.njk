<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<!-- security-meta -->
<meta name="viewport" content="width=device-width, initial-scale=1">
{% if site.review %}<meta name="robots" content="noindex, nofollow">
{% endif %}
<title>{{ (pg.meta | topic(lang)).title | safe }}</title>
{% for code in langs %}<link rel="alternate" hreflang="{{ code }}" href="{{ path | lurl(code) }}">
{% endfor %}<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="stylesheet" href="/css/fonts.css">
<link rel="stylesheet" href="/css/site.css">
<link rel="stylesheet" href="/css/play.css">
<link rel="stylesheet" href="/css/compact.css">
<link rel="stylesheet" href="/css/consent.css">
<link rel="stylesheet" href="/css/status.css">
<script>window.SITE_BASE = "{{ site.prefix }}"; window.SITE_LANG = "{{ lang }}"; window.I18N = {{ lang | uiStrings | safe }};
window.tx = function (k, vars) { var s = window.I18N[k] || k; for (var v in vars || {}) s = s.split("{" + v + "}").join(vars[v]); return s; };</script>
</head>
<body>
{% if site.review %}<div class="notice notice-info review-note" role="note"><div class="notice-inner"><p>{% if site.previewOf %}{{ "preview_banner" | label(lang) | replace("{n}", site.previewOf) | safe }}{% else %}{{ "review_banner" | ui(lang) }}{% endif %}</p></div></div>
{% endif %}{% include "partials/wrapper-open.html" %}
{{ content | safe }}
{% include "partials/footer.njk" %}
{% include "partials/tail.html" %}
