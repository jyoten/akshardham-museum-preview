{#- A small card: image (or a photo placeholder), kind and name; a link when the topic has one. Expects `item` and `lazy`. -#}
{% if item.action and item.action.link %}<a href="{{ (item.action.link | link(lang)).href }}" class="card" style="display:flex;flex-direction:column;gap:14px">{% else %}<div style="display:flex;flex-direction:column;gap:14px">{% endif %}
{% if item.media and item.media.length %}<div style="overflow:hidden;aspect-ratio:4/3;background:var(--sand)"><img src="{{ item.media[0].src }}" alt="{{ item.media[0].alt | safe }}"{% if lazy %} loading="lazy"{% endif %} style="width:100%;height:100%;object-fit:cover;display:block"></div>{% else %}<div style="aspect-ratio:4/3;background:var(--sand);display:flex;align-items:center;justify-content:center"><mark class="todo">{{ "photo_placeholder" | label(lang) | safe }}</mark></div>{% endif %}
<div><p style="margin:0;font-size:13px;color:var(--muted)">{{ item.subheading | safe }}</p><h3 style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:23px;margin:2px 0 0">{{ item.title | safe }}</h3></div>
{% if item.action and item.action.link %}</a>{% else %}</div>{% endif %}
