<section aria-labelledby="tl-h" style="background:var(--night);color:var(--cream);padding:clamp(45px,5.00vw,72px) 0">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(440px,100%),1fr));gap:34px 96px;align-items:center">
<div style="display:flex;flex-direction:column;gap:28px">
<p style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--gold)">{{ t.subheading | safe }}</p>
<h2 id="tl-h" style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(38px,4.2vw,58px);line-height:1.05;margin:0">{{ t.title | safe }}</h2>
<p style="margin:0;font-size:18px;color:var(--stone);max-width:520px">{{ t.description | safe }}</p>
<ol style="list-style:none;margin:8px 0 0;padding:0;max-width:560px">{% for item in t.topics %}<li class="tl-row" style="display:flex;gap:18px;align-items:baseline;padding:9px 0;border-bottom:1px solid var(--umber)"><a href="{{ (item.action.link | link(lang)).href }}" class="tl-link">
<span style="flex:0 0 110px;font-size:13px;color:var(--gold);letter-spacing:.04em">{{ item.subheading | safe }}</span>
<span style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:21px;color:var(--cream)">{{ item.title | safe }}</span>
</a></li>{% endfor %}</ol>
<a href="{{ (t.action.link | link(lang)).href }}" style="display:inline-flex;align-items:center;gap:10px;font-weight:600;font-size:15px;text-decoration:none;color:var(--gold)">{{ t.action.label | safe }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></a>
</div>
<div style="overflow:hidden;aspect-ratio:4/5;max-height:600px;background:#2A211B"><img src="{{ t.media[0].src }}" alt="{{ t.media[0].alt | safe }}" style="width:100%;height:100%;object-fit:cover;display:block"></div>
</div>
</section>
