<section aria-labelledby="voices-h" style="padding:clamp(50px,5.56vw,80px) 0">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;display:flex;flex-direction:column;gap:34px">
<div style="display:flex;flex-direction:column;gap:16px">
<p style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--accent)">{{ t.subheading | safe }}</p>
<h2 id="voices-h" style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(34px,3.6vw,50px);line-height:1.1;margin:0">{{ t.title | safe }}</h2>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:40px">
{% for item in t.topics %}<figure style="margin:0;display:flex;flex-direction:column;gap:24px;border-top:1px solid var(--line);padding-top:28px">
<blockquote style="margin:0;font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:24px;line-height:1.4;text-wrap:pretty">{{ item.description | safe }}</blockquote>
<figcaption style="font-size:14px;color:var(--muted)"><strong style="color:var(--ink);font-weight:600">{{ item.title | safe }}</strong> · {{ item.subheading | safe }}</figcaption>
</figure>
{% endfor %}</div>
</div>
</section>
