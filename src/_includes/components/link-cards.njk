<section id="give" aria-labelledby="g-h" style="padding:clamp(45px,5.00vw,72px) 0">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;display:flex;flex-direction:column;gap:44px">
<h2 id="g-h" style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(34px,3.6vw,50px);line-height:1.1;margin:0">{{ t.title | safe }}</h2>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr));gap:0 40px">
{% for item in t.topics %}<a href="{{ (item.action.link | link(lang)).href }}" class="card" style="display:flex;flex-direction:column;gap:8px;border-top:2px solid var(--ink);padding:22px 0 28px"><span style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:26px">{{ item.title | safe }}</span><span style="color:var(--muted);font-size:16px">{{ item.description | safe }}</span></a>
{% endfor %}</div>
</div>
</section>
