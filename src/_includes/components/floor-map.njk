<section aria-labelledby="map-h" style="padding:0 0 128px">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(380px,100%),1fr));gap:29px 72px;align-items:center">
<div style="display:flex;flex-direction:column;gap:20px">
<p style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--accent)">{{ t.subheading | safe }}</p>
<h2 id="map-h" style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(34px,3.6vw,50px);line-height:1.1;margin:0">{{ t.title | safe }}</h2>
<div role="tablist" aria-label="{{ "floors" | label(lang) | safe }}" data-l="Floors" style="display:flex;gap:8px;margin-top:8px">
{% for floor in t.topics %}{% if loop.first %}<button type="button" role="tab" aria-selected="true" style="min-width:64px;min-height:48px;border:0;background:var(--ink);color:var(--cream);font:inherit;font-weight:600;cursor:pointer;border-radius:2px">{% else %}<button type="button" role="tab" aria-selected="false" style="min-width:64px;min-height:48px;border:1px solid var(--line-strong);background:transparent;color:var(--ink);font:inherit;font-weight:600;cursor:pointer;border-radius:2px;padding:0 14px">{% endif %}{{ floor.title | safe }}</button>
{% endfor %}</div>
<p style="margin:0;font-size:17px;color:var(--muted)">{{ t.description | safe }}</p>
<a href="{{ (t.action.link | link(lang)).href }}" style="display:inline-flex;align-items:center;gap:10px;font-weight:600;font-size:15px;text-decoration:none;color:var(--accent)">{{ t.action.label | safe }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></a>
</div>
<div role="img" aria-label="{{ "floor_plan" | label(lang) | safe }}" data-l="Floor plan placeholder" style="aspect-ratio:16/11;background:var(--sand);border:1px dashed #B9A68D;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:15px;letter-spacing:.08em"><mark class="todo">{{ "floor_plan_placeholder" | label(lang) | safe }}</mark></div>
</div>
</section>
