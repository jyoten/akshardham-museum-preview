<section aria-labelledby="clp-h" style="padding:clamp(45px,5.00vw,72px) 0">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:34px 88px;align-items:center">
<div style="overflow:hidden;aspect-ratio:4/3;max-height:460px;background:var(--sand)"><img src="{{ t.media[0].src }}" alt="{{ t.media[0].alt | safe }}" style="width:100%;height:100%;object-fit:cover;display:block"></div>
<div style="display:flex;flex-direction:column;gap:24px">
<p style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--accent)">{{ t.subheading | safe }}</p>
<h2 id="clp-h" style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(36px,4vw,56px);line-height:1.06;margin:0">{{ t.title | safe }}</h2>
<p style="margin:0;font-size:19px;line-height:1.65">{{ t.description | safe }}</p>
{% for note in t.topics %}<p style="margin:0;font-size:17px;color:var(--muted)">{{ note.description | safe }}</p>
{% endfor %}<a href="{{ (t.action.link | link(lang)).href }}" style="display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 26px;border-radius:2px;font-size:15px;font-weight:600;text-decoration:none;box-sizing:border-box;background:var(--accent);color:var(--white);align-self:flex-start">{{ t.action.label | safe }}</a>
</div>
</div>
</section>
