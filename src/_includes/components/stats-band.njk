<section aria-label="{{ "home_in_numbers" | label(lang) | safe }}" data-l="The museum in numbers" style="background:#5C1A14;color:var(--cream);padding:clamp(40px,4.44vw,64px) 0">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;display:flex;flex-direction:column;gap:34px">
<h2 style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(30px,3vw,42px);line-height:1.15;margin:0;max-width:760px">{{ t.title | safe }}</h2>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(140px,100%),1fr));gap:40px 32px">
{% for item in t.topics %}<div style="display:flex;flex-direction:column;gap:6px;border-top:1px solid rgba(240,201,160,.35);padding-top:20px">
<span style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(44px,5vw,64px);line-height:1;color:var(--cream)">{{ item.title | safe }}</span>
<span style="font-size:14px;letter-spacing:.06em;color:var(--peach)">{{ item.subheading | safe }}</span>
</div>{% endfor %}
</div>
</div>
</section>
