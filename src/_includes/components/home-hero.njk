<section aria-label="{{ "home_welcome" | label(lang) | safe }}" data-l="Welcome" style="position:relative;min-height:min(80vh,720px);display:flex;flex-direction:column;justify-content:flex-end;color:var(--cream);background:var(--night);overflow:hidden">
<img src="{{ t.media[0].src }}" alt="{{ t.media[0].alt | safe }}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 62%">
<div aria-hidden="true" style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(18,13,10,.72) 0%,rgba(18,13,10,.05) 26%,rgba(18,13,10,.1) 50%,rgba(18,13,10,.9) 100%)"></div>
{% include "partials/header.njk" %}
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;position:relative;z-index:1;padding-bottom:clamp(30px,3.33vw,48px);display:flex;flex-wrap:wrap;gap:32px;align-items:flex-end;justify-content:space-between">
<div style="max-width:880px;display:flex;flex-direction:column;gap:28px">
<p style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--gold)">{{ t.subheading | safe }}</p>
<h1 style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(48px,6.6vw,100px);line-height:1;margin:0;letter-spacing:-.005em;text-wrap:balance">{{ t.title | safe }}</h1>
<div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:8px">
<a href="{{ (t.action.link | link(lang)).href }}" style="display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 26px;border-radius:2px;font-size:15px;font-weight:600;text-decoration:none;box-sizing:border-box;background:var(--accent);color:var(--white)">{{ t.action.label | safe }}</a>{% for b in t.topics %}
<a href="{{ (b.action.link | link(lang)).href }}" style="display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 26px;border-radius:2px;font-size:15px;font-weight:600;text-decoration:none;box-sizing:border-box;border:1px solid rgba(247,244,239,.7);color:var(--cream)">{{ b.action.label | safe }}</a>{% endfor %}
</div>
</div>
<p style="margin:0;font-size:13px;color:#E6DCCF;max-width:260px;text-align:right">{{ t.media[0].caption | safe }}</p>
</div>
</section>
