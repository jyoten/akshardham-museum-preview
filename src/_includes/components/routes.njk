<section aria-labelledby="it-h" style="padding:clamp(45px,5.00vw,72px) 0">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;display:flex;flex-direction:column;gap:29px">
<div style="display:flex;flex-direction:column;gap:16px;max-width:720px">
<p style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--accent)">{{ t.subheading | safe }}</p>
<h2 id="it-h" style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(34px,3.6vw,50px);line-height:1.1;margin:0">{{ t.title | safe }}</h2>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:28px;background:var(--sand);padding:28px">
{% for route in t.topics %}<article style="display:flex;flex-direction:column;background:var(--cream)">
<div style="aspect-ratio:2/1;overflow:hidden;background:var(--sand)"><img src="{{ route.media[0].src }}" alt="{{ route.media[0].alt | safe }}" style="width:100%;height:100%;object-fit:cover;display:block"></div>
<div style="padding:28px;display:flex;flex-direction:column;gap:14px">
<p style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--accent)">{{ route.subheading | safe }}</p>
<h3 style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:28px;margin:0;line-height:1.1">{{ route.title | safe }}</h3>
<ol style="margin:0;padding:0 0 0 20px;font-size:16px">{% for stop in route.topics %}<li style="padding:10px 0;border-bottom:1px solid var(--line-soft)">{{ stop.title | safe }}</li>{% endfor %}</ol>
</div>
</article>
{% endfor %}</div>
</div>
</section>
