<section aria-label="{{ t.title | safe }}" data-l="On the timeline and plan" style="background:var(--sand);padding:clamp(30px,3.33vw,48px) 0">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;display:flex;flex-wrap:wrap;gap:24px 56px;align-items:center;justify-content:space-between">
<div style="display:flex;flex-direction:column;gap:8px">
<p style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--accent)">{{ t.subheading | safe }}</p>
<p style="margin:0;font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:30px">{{ t.description | safe }}</p>
</div>
<div style="display:flex;gap:14px;flex-wrap:wrap">
<a href="{{ (t.action.link | link(lang)).href }}" style="display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 26px;border-radius:2px;font-size:15px;font-weight:600;text-decoration:none;box-sizing:border-box;border:1px solid var(--ink);color:var(--ink)">{{ t.action.label | safe }}</a>{% for b in t.topics %}
<a href="{{ (b.action.link | link(lang)).href }}" style="display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 26px;border-radius:2px;font-size:15px;font-weight:600;text-decoration:none;box-sizing:border-box;background:var(--accent);color:var(--white)">{{ b.action.label | safe }}</a>{% endfor %}
</div>
</div>
</section>
