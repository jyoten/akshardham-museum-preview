<section aria-labelledby="nf-h" style="padding:140px 0 160px">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;display:flex;flex-direction:column;gap:24px;align-items:flex-start">
<p style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--accent)">{{ t.subheading | safe }}</p>
<h1 id="nf-h" style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(40px,4.6vw,64px);line-height:1.04;margin:0">{{ t.title | safe }}</h1>
<p style="margin:0;font-size:19px;color:var(--muted);max-width:560px">{{ t.description | safe }}</p>
<div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:8px">
<a href="{{ (t.action.link | link(lang)).href }}" style="display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 26px;border-radius:2px;font-size:15px;font-weight:600;text-decoration:none;background:var(--accent);color:var(--white)">{{ t.action.label | safe }}</a>{% for b in t.topics %}
<a href="{{ (b.action.link | link(lang)).href }}" style="display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 26px;border-radius:2px;font-size:15px;font-weight:600;text-decoration:none;border:1px solid var(--ink);color:var(--ink)">{{ b.action.label | safe }}</a>{% endfor %}
</div>
</div>
</section>
