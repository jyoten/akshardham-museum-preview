<section aria-label="{{ t.title | safe }}" data-l="Ways to learn" style="background:var(--sand);padding:clamp(50px,5.56vw,80px) 0">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;display:flex;flex-direction:column;gap:34px">
<div style="display:flex;flex-direction:column;gap:16px;max-width:720px">
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(380px,100%),1fr));gap:28px">
{% for item in t.topics %}{% if item.media.length %}{% set L = item.action.link | link(lang) %}<a href="{{ L.href }}" id="{{ item.id }}" class="card{% if L.todo %} todo-link" data-todo="{{ L.todo | safe }}{% endif %}" style="display:grid;grid-template-columns:minmax(0,2fr) minmax(0,3fr);background:var(--cream);min-height:360px">
<div style="overflow:hidden;background:var(--tint)"><img src="{{ item.media[0].src }}" alt="{{ item.media[0].alt | safe }}" style="width:100%;height:100%;object-fit:cover;display:block"></div>
<div style="padding:36px;display:flex;flex-direction:column;gap:14px;justify-content:center">
<h3 style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:30px;line-height:1.1;margin:0">{{ item.title | safe }}</h3>
<p style="margin:0;color:var(--muted);font-size:16px">{{ item.description | safe }}</p>
<span style="display:inline-flex;align-items:center;gap:10px;font-weight:600;font-size:15px;color:var(--accent)">{{ item.action.label | safe }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></span>
</div>
</a>
{% endif %}{% endfor %}</div>
{% for group in t.topics %}{% if not group.media.length %}<div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center">
<span style="font-size:14px;font-weight:600;margin-right:8px">{{ group.title | safe }}</span>
{% for idea in group.topics %}<button type="button" class="idea-chip" aria-expanded="false" aria-controls="idea-meaning" data-meaning="{{ idea.description | safe }}" style="display:inline-flex;align-items:center;min-height:44px;padding:0 18px;border:1px solid var(--line-strong);border-radius:999px;color:var(--ink);text-decoration:none;font-size:15px">{{ idea.title | safe }}</button>
{% endfor %}</div>
{% endif %}{% endfor %}<p id="idea-meaning" class="idea-meaning" aria-live="polite" hidden></p>
</div>
</section>
