<section aria-labelledby="{{ s.headingId }}" class="page-hero" style="position:relative;background:var(--night);color:var(--cream);overflow:hidden">
<img src="{{ t.media[0].src }}" alt="{{ t.media[0].alt | safe }}" class="page-hero-img" style="position:absolute;right:0;top:0;height:100%;width:44%;object-fit:cover;opacity:.55">
<div aria-hidden="true" class="page-hero-fade" style="position:absolute;right:0;top:0;height:100%;width:44%;background:linear-gradient(90deg,var(--night) 0%,rgba(18,13,10,0) 45%)"></div>
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;position:relative;padding-top:clamp(40px,4.44vw,64px);padding-bottom:clamp(40px,4.44vw,64px);display:flex;flex-direction:column;gap:24px">
<p style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--gold)">{{ t.subheading | safe }}</p>
<h1 id="{{ s.headingId }}" style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(46px,5.6vw,82px);line-height:1.02;margin:0;max-width:820px;text-wrap:balance">{{ t.title | safe }}</h1>
<p style="margin:0;font-size:19px;color:var(--stone);max-width:600px">{{ t.description | safe }}</p>
{% if t.action -%}
<div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:4px"><a href="{{ (t.action.link | link(lang)).href }}" style="display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 26px;border-radius:2px;font-size:15px;font-weight:600;text-decoration:none;box-sizing:border-box;background:var(--accent);color:var(--white)">{{ t.action.label | safe }}</a>{% for b in t.topics %}<a href="{{ (b.action.link | link(lang)).href }}" style="display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 26px;border-radius:2px;font-size:15px;font-weight:600;text-decoration:none;box-sizing:border-box;border:1px solid rgba(247,244,239,.7);color:var(--cream)">{{ b.action.label | safe }}</a>{% endfor %}</div>
{% endif -%}
</div>
</section>
