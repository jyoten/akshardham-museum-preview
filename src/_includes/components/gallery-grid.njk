<section aria-labelledby="exp-h" style="padding:clamp(35px,3.89vw,56px) 0 clamp(45px,5.00vw,72px)">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;display:flex;flex-direction:column;gap:34px">
<div style="display:flex;flex-direction:column;gap:12px;max-width:760px">
<p style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--accent)">{{ t.subheading | safe }}</p>
<h2 id="exp-h" style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(32px,3.2vw,44px);line-height:1.1;margin:0">{{ t.title | safe }}</h2>
<p style="margin:0;font-size:18px;color:var(--muted)">{{ t.description | safe }}</p>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr));gap:40px 28px;align-items:start">
{% for item in t.topics %}<a href="{{ (item.action.link | link(lang)).href }}" class="card{% if loop.index is even %} stagger{% endif %}" style="{% if loop.index is even %}margin-top:44px;{% endif %}display:flex;flex-direction:column;gap:18px">
<div style="overflow:hidden;aspect-ratio:5/4;background:var(--sand)"><img src="{{ item.media[0].src }}" alt="{{ item.media[0].alt | safe }}" style="width:100%;height:100%;object-fit:cover;display:block"></div>
<div style="display:flex;flex-direction:column;gap:8px">
<span style="font-size:13px;font-weight:600;letter-spacing:.18em;color:var(--accent)">{{ item.subheading | safe }}</span>
<h3 style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:28px;line-height:1.15;margin:0">{{ item.title | safe }}</h3>
<p style="margin:0;color:var(--muted);font-size:16px;text-wrap:pretty">{{ item.description | safe }}</p>
</div>
</a>
{% endfor %}</div>
</div>
</section>
