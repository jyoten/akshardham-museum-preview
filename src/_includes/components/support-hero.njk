<section aria-labelledby="s-h" style="position:relative;background:var(--night);color:var(--cream);overflow:hidden;min-height:min(62vh,500px);display:flex;align-items:flex-end">
<img src="{{ t.media[0].src }}" alt="{{ t.media[0].alt | safe }}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%">
<div aria-hidden="true" style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(18,13,10,.92) 0%,rgba(18,13,10,.7) 45%,rgba(18,13,10,.15) 100%)"></div>
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;position:relative;padding-top:clamp(45px,5.00vw,72px);padding-bottom:clamp(35px,3.89vw,56px);display:flex;flex-direction:column;gap:24px">
<p style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--gold)">{{ t.subheading | safe }}</p>
<h1 id="s-h" style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(46px,5.6vw,82px);line-height:1.02;margin:0;max-width:780px;text-wrap:balance">{{ t.title | safe }}</h1>
<p style="margin:0;font-size:20px;color:#E6DCCF;max-width:560px">{{ t.description | safe }}</p>
<div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:8px">
<a href="{{ (t.action.link | link(lang)).href }}" style="display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 26px;border-radius:2px;font-size:15px;font-weight:600;text-decoration:none;box-sizing:border-box;background:var(--accent);color:var(--white)">{{ t.action.label | safe }}</a>{% for b in t.topics %}
<a href="{{ (b.action.link | link(lang)).href }}" style="display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 26px;border-radius:2px;font-size:15px;font-weight:600;text-decoration:none;box-sizing:border-box;border:1px solid rgba(247,244,239,.7);color:var(--cream)">{{ b.action.label | safe }}</a>{% endfor %}
</div>
</div>
</section>
