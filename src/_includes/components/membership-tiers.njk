<section id="membership" aria-labelledby="m-h" style="padding:clamp(45px,5.00vw,72px) 0">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;display:flex;flex-direction:column;gap:29px">
<div style="display:flex;flex-direction:column;gap:16px;max-width:720px">
<p style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--accent)">{{ t.subheading | safe }}</p>
<h2 id="m-h" style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(34px,3.6vw,50px);line-height:1.1;margin:0">{{ t.title | safe }}</h2>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:24px;align-items:stretch">
{% for tier in t.topics %}{% set featured = tier.subheading %}{% if featured %}<article style="background:var(--ink);color:var(--cream);padding:36px;display:flex;flex-direction:column;gap:20px">
<span style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--gold)">{{ tier.subheading | safe }}</span>
{% else %}<article style="background:var(--cream);color:var(--ink);border:1px solid var(--line);padding:36px;display:flex;flex-direction:column;gap:20px">
<span style="font-size:12px">​</span>
{% endif %}<h3 style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:34px;margin:0;line-height:1">{{ tier.title | safe }}</h3>
{% for price in tier.topics %}{% if price.id == "price" %}<p style="margin:0;font-size:18px"><strong style="font-weight:600">{{ price.title | safe }}</strong> <span style="color:var({{ "--stone" if featured else "--muted" }});font-size:15px">{{ price.subheading | safe }}</span></p>
{% endif %}{% endfor %}<ul style="list-style:none;margin:0;padding:0;font-size:16px;flex:1">{% for b in tier.topics %}{% if b.id != "price" %}<li style="padding:12px 0;border-top:1px solid var({{ "--umber" if featured else "--line-soft" }})">{{ b.title | safe }}</li>{% endif %}{% endfor %}</ul>
<a href="{{ (tier.action.link | link(lang)).href }}" style="display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 26px;border-radius:2px;font-size:15px;font-weight:600;text-decoration:none;box-sizing:border-box;{{ "background:var(--accent);color:var(--white)" if featured else "border:1px solid var(--ink);color:var(--ink)" }}">{{ tier.action.label | safe }}</a>
</article>
{% endfor %}</div>
</div>
</section>
