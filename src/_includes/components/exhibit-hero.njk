<section aria-labelledby="ex-h" style="padding:clamp(30px,3.33vw,48px) 0 clamp(35px,3.89vw,56px)">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(440px,100%),1fr));gap:34px 80px;align-items:end">
<div style="display:flex;flex-direction:column;gap:28px;padding-bottom:12px">
<p style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--accent)">{{ t.subheading | safe }}</p>
<h1 id="ex-h" style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(52px,6.4vw,92px);line-height:.98;margin:0">{{ t.title | safe }}</h1>
<p style="margin:0;font-size:21px;line-height:1.55;text-wrap:pretty">{{ t.description | safe }}</p>
{% for audio in t.topics %}<div style="display:flex;align-items:center;gap:18px;background:var(--sand);padding:18px 20px;max-width:460px">
<button type="button" aria-label="{{ audio.action.label | safe }}" data-l="Play audio guide, stop [#]" style="flex:0 0 52px;width:52px;height:52px;border-radius:50%;border:0;background:var(--ink);color:var(--cream);display:flex;align-items:center;justify-content:center;cursor:pointer">
<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
</button>
<div style="display:flex;flex-direction:column;gap:2px;flex:1">
<span style="font-weight:600;font-size:15px">{{ audio.title | safe }}</span>
<span style="font-size:13px;color:var(--muted)">{{ audio.description | safe }}</span>
</div>
</div>
{% endfor %}</div>
<figure style="margin:0;display:flex;flex-direction:column;gap:12px">
<div style="overflow:hidden;aspect-ratio:1/1;background:var(--sand)"><img src="{{ t.media[0].src }}" alt="{{ t.media[0].alt | safe }}" style="width:100%;height:100%;object-fit:cover;object-position:{{ s.imagePosition or "center" }};display:block"></div>
<figcaption style="font-size:13px;color:var(--muted)">{{ t.media[0].caption | safe }}</figcaption>
</figure>
</div>
</section>
