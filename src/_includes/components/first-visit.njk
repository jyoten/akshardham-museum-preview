<section aria-labelledby="first-h" style="background:var(--ink);color:var(--cream);padding:clamp(45px,5.00vw,72px) 0">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;display:flex;flex-direction:column;gap:34px">
<div style="display:flex;flex-direction:column;gap:16px;max-width:760px">
<p style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--gold)">{{ t.subheading | safe }}</p>
<h2 id="first-h" style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(34px,3.6vw,50px);line-height:1.1;margin:0">{{ t.title | safe }}</h2>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr));gap:40px">
{% for item in t.topics %}<div style="display:flex;flex-direction:column;gap:10px;border-top:1px solid var(--umber-2);padding-top:20px"><h3 style="margin:0;font-size:18px;font-weight:600">{{ item.title | safe }}</h3><p style="margin:0;color:var(--stone);font-size:16px">{{ item.description | safe }}</p></div>
{% endfor %}</div>
</div>
</section>
