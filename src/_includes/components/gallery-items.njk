<section aria-labelledby="in-h" style="padding:clamp(35px,3.89vw,56px) 0 clamp(45px,5.00vw,72px)">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;display:flex;flex-direction:column;gap:32px">
<div style="display:flex;flex-direction:column;gap:14px;max-width:760px">
<h2 id="in-h" style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(32px,3.2vw,44px);line-height:1.1;margin:0">{{ t.title | safe }}</h2>
<p style="margin:0;font-size:18px;color:var(--muted)">{{ t.description | safe }}</p>
</div>
<div class="snap-row" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr));gap:32px 24px">
{% for item in t.topics %}{% set lazy = true %}{% include "partials/card.njk" %}
{% endfor %}</div>
</div>
</section>
