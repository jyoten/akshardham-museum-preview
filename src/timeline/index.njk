---
{
 "layout": "layouts/base.njk",
 "pagination": {
  "data": "langs",
  "size": 1,
  "alias": "lang"
 },
 "path": "/timeline/",
 "permalink": "{{ \"/timeline/\" | lurl(lang) }}index.html",
 "titleKey": "timeline_031",
 "navKey": "timeline",
 "headerStyle": "position:relative;background:var(--ink);color:var(--cream)"
}
---


{% include "partials/header.njk" %}
<section aria-labelledby="tl-title" style="position:relative;background:var(--night);color:var(--cream);overflow:hidden">
<img src="/images/timeline-corridor.jpg" alt="" style="position:absolute;right:0;top:0;height:100%;width:44%;object-fit:cover;opacity:.55" class="hide-sm">
<div aria-hidden="true" class="hide-sm" style="position:absolute;right:0;top:0;height:100%;width:44%;background:linear-gradient(90deg,var(--night) 0%,rgba(18,13,10,0) 45%)"></div>
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;position:relative;padding-top:clamp(40px,4.44vw,64px);padding-bottom:clamp(40px,4.44vw,64px);display:flex;flex-direction:column;gap:24px">
<p style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--gold)">{{ "timeline_001" | t(lang) | safe }}</p>
<h1 id="tl-title" style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(46px,5.6vw,82px);line-height:1.02;margin:0;max-width:820px;text-wrap:balance">{{ "timeline_002" | t(lang) | safe }}</h1>
<p style="margin:0;font-size:19px;color:var(--stone);max-width:600px">{{ "timeline_003" | t(lang) | safe }}</p>
</div>
</section>

<section aria-label="{{ "timeline_004" | t(lang) | safe }}" style="background:var(--ink);position:relative">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;overflow-x:auto;padding-top:0;padding-bottom:0">
<ol id="era-list" class="era-list" style="list-style:none;margin:0;padding:0;display:flex;gap:0;min-width:max-content">
<li style="display:flex"><button type="button" class="era-btn" data-era="0" aria-pressed="false"><span class="era-btn-dates">{{ "timeline_005" | t(lang) | safe }}</span><span class="era-btn-name">{{ "timeline_006" | t(lang) | safe }}</span></button></li>
<li style="display:flex"><button type="button" class="era-btn" data-era="1" aria-pressed="false"><span class="era-btn-dates">{{ "timeline_007" | t(lang) | safe }}</span><span class="era-btn-name">{{ "timeline_008" | t(lang) | safe }}</span></button></li>
<li style="display:flex"><button type="button" class="era-btn" data-era="2" aria-pressed="false"><span class="era-btn-dates">{{ "timeline_009" | t(lang) | safe }}</span><span class="era-btn-name">{{ "timeline_010" | t(lang) | safe }}</span></button></li>
<li style="display:flex"><button type="button" class="era-btn" data-era="3" aria-pressed="false"><span class="era-btn-dates">{{ "timeline_011" | t(lang) | safe }}</span><span class="era-btn-name">{{ "timeline_012" | t(lang) | safe }}</span></button></li>
<li style="display:flex"><button type="button" class="era-btn" data-era="4" aria-pressed="true"><span class="era-btn-dates">{{ "timeline_013" | t(lang) | safe }}</span><span class="era-btn-name">{{ "timeline_014" | t(lang) | safe }}</span></button></li>
<li style="display:flex"><button type="button" class="era-btn" data-era="5" aria-pressed="false"><span class="era-btn-dates">{{ "timeline_015" | t(lang) | safe }}</span><span class="era-btn-name">{{ "timeline_016" | t(lang) | safe }}</span></button></li>
<li style="display:flex"><button type="button" class="era-btn" data-era="6" aria-pressed="false"><span class="era-btn-dates">{{ "timeline_017" | t(lang) | safe }}</span><span class="era-btn-name">{{ "timeline_018" | t(lang) | safe }}</span></button></li>
<li style="display:flex"><button type="button" class="era-btn" data-era="7" aria-pressed="false"><span class="era-btn-dates">{{ "timeline_019" | t(lang) | safe }}</span><span class="era-btn-name">{{ "timeline_020" | t(lang) | safe }}</span></button></li>
<li style="display:flex"><button type="button" class="era-btn" data-era="8" aria-pressed="false"><span class="era-btn-dates">{{ "timeline_021" | t(lang) | safe }}</span><span class="era-btn-name">{{ "timeline_022" | t(lang) | safe }}</span></button></li>
</ol>
</div>
</section>

<section aria-live="polite" aria-labelledby="era-h" style="padding:clamp(35px,3.89vw,56px) 0 clamp(45px,5.00vw,72px)">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(440px,100%),1fr));gap:34px 88px;align-items:start">
<div style="display:flex;flex-direction:column;gap:24px">
<p style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--accent)"><span id="era-meta"></span></p>
<h2 id="era-h" style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(40px,4.6vw,64px);line-height:1.04;margin:0"><span id="era-name"></span></h2>
<p style="margin:0;font-size:20px;line-height:1.65;text-wrap:pretty" id="era-summary"></p>
<div style="display:flex;flex-direction:column;gap:12px;border-top:1px solid var(--line);padding-top:22px">
<span style="font-size:13px;font-weight:600;letter-spacing:.14em;color:var(--muted)">{{ "timeline_023" | t(lang) | safe }}</span>
<p style="margin:0;font-size:17px" id="era-keys"></p>
</div>
<div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:8px">
<button type="button" id="era-prev" aria-label="{{ "timeline_024" | t(lang) | safe }}" style="display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 26px;border-radius:2px;font-size:15px;font-weight:600;text-decoration:none;box-sizing:border-box;background:transparent;border:1px solid var(--ink);color:var(--ink);cursor:pointer">{{ "timeline_025" | t(lang) | safe }}</button>
<button type="button" id="era-next" aria-label="{{ "timeline_026" | t(lang) | safe }}" style="display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 26px;border-radius:2px;font-size:15px;font-weight:600;text-decoration:none;box-sizing:border-box;background:var(--ink);border:1px solid var(--ink);color:var(--cream);cursor:pointer">{{ "timeline_027" | t(lang) | safe }}</button>
</div>
</div>
<div style="display:flex;flex-direction:column;gap:20px">
<p style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--accent)">{{ "timeline_028" | t(lang) | safe }}</p>
<div id="era-see" style="display:contents"></div>
</div>
</div>
</section>

<section aria-label="{{ "timeline_029" | t(lang) | safe }}" style="padding:0 0 96px">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%"><p style="margin:0;font-size:14px;color:var(--muted);max-width:720px;border-top:1px solid var(--line);padding-top:20px">{{ "timeline_030" | t(lang) | safe }}</p></div>
</section>
{% raw %}<template id="era-card"><a href="{{s.href}}" class="card" style="display:grid;grid-template-columns:140px minmax(0,1fr);gap:20px;align-items:center;background:var(--sand);min-height:120px">
<div style="height:100%;min-height:120px;overflow:hidden;background:var(--tint)">
{{IMG}}
</div>
<div style="display:flex;flex-direction:column;gap:4px;padding:16px 20px 16px 0">
<span style="font-size:13px;color:var(--muted)">{{s.kind}}</span>
<span style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:23px;line-height:1.15">{{s.title}}</span>
<span style="font-size:14px;color:var(--accent);font-weight:600">{{s.where}}</span>
</div>
</a></template>{% endraw %}
<script type="application/json" id="eras-data">{{ lang | eras | safe }}</script>
<script src="/js/timeline.js" defer></script>
