---
{
 "layout": "layouts/base.njk",
 "pagination": {
  "data": "langs",
  "size": 1,
  "alias": "lang"
 },
 "path": "/learn/",
 "permalink": "{{ \"/learn/\" | lurl(lang) }}index.html",
 "titleKey": "learn_026",
 "navKey": "learn",
 "headerStyle": "position:relative;background:var(--ink);color:var(--cream)"
}
---


{% include "partials/header.njk" %}
<section aria-labelledby="learn-h" class="page-hero" style="position:relative;background:var(--night);color:var(--cream);overflow:hidden">
<img src="/images/scholars-diorama.jpg" alt="" class="page-hero-img" style="position:absolute;right:0;top:0;height:100%;width:44%;object-fit:cover;opacity:.55">
<div aria-hidden="true" class="page-hero-fade" style="position:absolute;right:0;top:0;height:100%;width:44%;background:linear-gradient(90deg,var(--night) 0%,rgba(18,13,10,0) 45%)"></div>
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;position:relative;padding-top:clamp(40px,4.44vw,64px);padding-bottom:clamp(40px,4.44vw,64px);display:flex;flex-direction:column;gap:24px">
<p style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--gold)">{{ "learn_001" | t(lang) | safe }}</p>
<h1 id="learn-h" style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(46px,5.6vw,82px);line-height:1.02;margin:0;max-width:820px;text-wrap:balance">{{ "learn_002" | t(lang) | safe }}</h1>
<p style="margin:0;font-size:19px;color:var(--stone);max-width:600px">{{ "learn_003" | t(lang) | safe }}</p>
</div>
</section>

