<div style="display:flex;flex-direction:column;gap:16px;max-width:720px">
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(380px,100%),1fr));gap:28px">
<a href="#" id="schools" class="card todo-link" data-todo="School & group visits (no page)" style="display:grid;grid-template-columns:minmax(0,2fr) minmax(0,3fr);background:var(--cream);min-height:360px">
<div style="overflow:hidden;background:var(--tint)"><img src="/images/young-visitor-carved-model.jpg" alt="{{ "learn_005" | t(lang) | safe }}" style="width:100%;height:100%;object-fit:cover;display:block"></div>
<div style="padding:36px;display:flex;flex-direction:column;gap:14px;justify-content:center">
<h3 style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:30px;line-height:1.1;margin:0">{{ "learn_006" | t(lang) | safe }}</h3>
<p style="margin:0;color:var(--muted);font-size:16px">{{ "learn_007" | t(lang) | safe }}</p>
<span style="display:inline-flex;align-items:center;gap:10px;font-weight:600;font-size:15px;color:var(--accent)">{{ "learn_008" | t(lang) | safe }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></span>
</div>
</a>
