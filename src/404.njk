---
{
 "layout": "layouts/base.njk",
 "pagination": {
  "data": "langs",
  "size": 1,
  "alias": "lang"
 },
 "path": "/404.html",
 "permalink": "{% if lang == \"en\" %}/404.html{% else %}/{{ lang }}/404.html{% endif %}",
 "titleKey": "notfound_006",
 "navKey": "explore",
 "headerStyle": "position:relative;background:var(--ink);color:var(--cream)"
}
---


{% include "partials/header.njk" %}
<section aria-labelledby="nf-h" style="padding:140px 0 160px">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);box-sizing:border-box;width:100%;display:flex;flex-direction:column;gap:24px;align-items:flex-start">
<p style="margin:0;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--accent)">{{ "notfound_001" | t(lang) | safe }}</p>
<h1 id="nf-h" style="font-family:'Marcellus','Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(40px,4.6vw,64px);line-height:1.04;margin:0">{{ "notfound_002" | t(lang) | safe }}</h1>
<p style="margin:0;font-size:19px;color:var(--muted);max-width:560px">{{ "notfound_003" | t(lang) | safe }}</p>
<div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:8px">
<a href="{{ "/" | lurl(lang) }}" style="display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 26px;border-radius:2px;font-size:15px;font-weight:600;text-decoration:none;background:var(--accent);color:var(--white)">{{ "notfound_004" | t(lang) | safe }}</a>
<a href="{{ "/visit" | lurl(lang) }}" style="display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 26px;border-radius:2px;font-size:15px;font-weight:600;text-decoration:none;border:1px solid var(--ink);color:var(--ink)">{{ "notfound_005" | t(lang) | safe }}</a>
</div>
</div>
</section>

