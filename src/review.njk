---js
const permalink = "/review/index.html";
const eleventyExcludeFromCollections = true;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<!-- security-meta -->
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta name="description" content="Comments from Yoganand Swami, Oct 28.">
<title>Website Review Changes</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="stylesheet" href="/css/fonts.css">
<link rel="stylesheet" href="/css/site.css">
<link rel="stylesheet" href="/css/review.css">
</head>
<body class="review">
<header class="mast">
  <div class="mast-inner">
    <p class="name">AKSHARDHAM</p>
    <p class="place">Museum · Robbinsville, NJ</p>
  </div>
</header>
<main class="wrap">
  <h1>Website Review Changes</h1>
  <p class="sub">Comments from Yoganand Swami, Oct 28 · View links show the updated pages</p>
  <hr class="rule">

  <section class="sheet-block" data-noun="comment">
  <div class="chips" aria-label="Count by status">
    {% for label in reviewTracker.statuses %}
      <span class="chip" data-status="{{ label | statusKey }}"><span class="count">{{ reviewTracker.counts[label] }}</span> {{ label }}</span>
    {% endfor %}
  </div>

  <div class="filters" role="group" aria-label="Filter by status">
    <button type="button" class="filter" data-filter="all" aria-pressed="true">All</button>
    {% for label in reviewTracker.statuses %}
      <button type="button" class="filter" data-filter="{{ label | statusKey }}" aria-pressed="false">{{ label }}</button>
    {% endfor %}
    <p class="shown" aria-live="polite">{{ reviewTracker.items | length }} comments</p>
  </div>

  <div class="panel">
    <div class="table-wrap">
      <table class="sheet">
        <caption class="vh">Website review comments</caption>
        <thead>
          <tr>
            <th scope="col">#</th>
            <th scope="col">Page</th>
            <th scope="col">Change requested</th>
            <th scope="col">Before / After</th>
            <th scope="col">Status</th>
            <th scope="col">View</th>
          </tr>
        </thead>
        <tbody>
          {% for item in reviewTracker.items %}
            <tr data-status="{{ item.status | statusKey }}">
              <td class="n">{{ item.n }}</td>
              <td class="page">{{ item.page }}</td>
              <td class="change" data-label="Change requested">{{ item.change }}</td>
              <td class="ba" data-label="Before / After">
                <span class="k">Before</span>
                <p class="was">{{ item.before }}</p>
                <span class="k">After</span>
                <p class="now">{{ item.after }}</p>
              </td>
              <td class="status"><span class="pill" data-status="{{ item.status | statusKey }}">{{ item.status }}</span></td>
              <td class="go" data-label="View">
                {% if item.view %}
                  <div class="views">
                    {% for link in item.view %}
                      <a class="view" href="{{ reviewTracker.previewBase }}{{ link.href }}{% if link.text %}{{ link.text | textFragment }}{% endif %}" target="_blank" rel="noopener noreferrer">{% if link.label %}{{ link.label }}{% else %}View{% endif %}<span class="vh"> (opens in a new tab)</span></a>
                    {% endfor %}
                  </div>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  <p class="none" hidden>No comments with this status.</p>
  </section>

  <section class="sheet-block" data-noun="photo" aria-labelledby="photos-h">
    <h2 id="photos-h">Photos</h2>
    <p class="sub">Museum photographs on the live pages, and the pictures still to come · View links open the live page at that picture</p>
    <hr class="rule">

    <div class="chips" aria-label="Count by photo status">
      {% for label in reviewTracker.photoStatuses %}
        <span class="chip" data-status="{{ label | statusKey }}"><span class="count">{{ reviewTracker.photoCounts[label] }}</span> {{ label }}</span>
      {% endfor %}
    </div>

    <div class="filters" role="group" aria-label="Filter photos by status">
      <button type="button" class="filter" data-filter="all" aria-pressed="true">All</button>
      {% for label in reviewTracker.photoStatuses %}
        <button type="button" class="filter" data-filter="{{ label | statusKey }}" aria-pressed="false">{{ label }}</button>
      {% endfor %}
      <p class="shown" aria-live="polite">{{ reviewTracker.photos | length }} photos</p>
    </div>

    <div class="panel">
      <div class="table-wrap">
        <table class="sheet">
          <caption class="vh">Photographs</caption>
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Page</th>
              <th scope="col">Photo</th>
              <th scope="col">Before / After</th>
              <th scope="col">Status</th>
              <th scope="col">View</th>
            </tr>
          </thead>
          <tbody>
            {% for item in reviewTracker.photos %}
              <tr data-status="{{ item.status | statusKey }}">
                <td class="n">{{ item.n }}</td>
                <td class="page">{{ item.page }}</td>
                <td class="change" data-label="Photo">{{ item.change }}</td>
                <td class="ba" data-label="Before / After">
                  <div class="pair">
                    <div class="shot">
                      <span class="k">{% if item.after %}Before{% else %}Now{% endif %}</span>
                      <img src="{{ item.before }}" alt="{% if item.after %}Earlier photograph{% else %}Photograph on the page{% endif %}, {{ item.page }} {{ item.change }}" width="168" height="126" loading="lazy">
                    </div>
                    <div class="shot">
                      <span class="k">After</span>
                      {% if item.after %}
                        <img src="{{ item.after }}" alt="Photograph now on {{ item.page }}, {{ item.change }}" width="168" height="126" loading="lazy">
                      {% elif item.note %}
                        <p class="now">{{ item.note }}</p>
                      {% else %}
                        <p class="now">Waiting for a museum photo.</p>
                      {% endif %}
                    </div>
                  </div>
                </td>
                <td class="status"><span class="pill" data-status="{{ item.status | statusKey }}">{{ item.status }}</span></td>
                <td class="go" data-label="View">
                  <a class="view" href="{{ reviewTracker.liveBase }}{{ item.view }}" target="_blank" rel="noopener noreferrer">View<span class="vh"> (opens in a new tab)</span></a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    <p class="none" hidden>No photos with this status.</p>
  </section>
</main>
<footer class="foot"><p>Akshardham Museum · Robbinsville, NJ</p></footer>
<script src="/js/review.js"></script>
</body>
</html>
